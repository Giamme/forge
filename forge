#!/usr/bin/env bash
set -uo pipefail
# npm runs this file through a symlink in its bin dir, usually a relative one. Follow the
# links so ROOT is the package and not the bin dir; older macOS has no readlink -f.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
ROOT="$(cd -P "$(dirname "$SELF")" && pwd)"

usage() {
  printf '%s\n' \
    'usage: forge <command> [args]' \
    '' \
    'commands:' \
    '  install   link forge into each agent harness on this machine; --dry-run previews' \
    '  fractal   opt-in Fractal execution: install, doctor, runs, status, tree, logs, open, report, ...' \
    '  decide    decision-model gates: status, gate, provider, budget, privacy, doctor, migrate, report' \
    '  jev       the old decision-model commands, replaced by decide (kept for one release)' \
    '  dataset   every run'"'"'s inputs and outcomes: status, dump, import, export, outcomes, ...' \
    '  issues    file the review findings a run left open as GitHub issues (plain gh)' \
    '  ui        forge-ui, the run viewer: open [DIR], status, stop' \
    '  runs      this repo'"'"'s recent runs in the terminal: state, verdicts and run dirs' \
    '  control   a plan'"'"'s live controls: show, set (QA threshold, retries, timeouts), pin, unpin' \
    '  config    every config source: show, and set/unset the per-repo .forge files and Jev on/off' \
    '  update    fast-forward this checkout and refresh every harness installation' \
    '  version   the installed version, and whether a newer release is out' \
    '' \
    'Run `forge <command> --help` for its options.' \
    'Runs start from your agent harness (/forge "<goal>" --dwarf <model>); see README.md.'
}

# suggest WORD — the listed command WORD most likely meant (a unique prefix or a close
# spelling), read from usage so the two never drift apart; prints nothing when none is close
# or python3 is missing. -I keeps a stray module in the current directory out of it.
suggest() {
  usage | python3 -I -c 'import difflib, re, sys
word = sys.argv[1].lower()
names = re.findall(r"^  ([a-z]+) ", sys.stdin.read(), re.M)
prefixed = [name for name in names if len(word) >= 2 and name.startswith(word)]
hit = prefixed if len(prefixed) == 1 else difflib.get_close_matches(word, names, 1, 0.6)
print(hit[0] if hit else "")' "$1" 2>/dev/null
}

case "${1:-}" in
  install)
    shift
    exec /bin/bash "$ROOT/scripts/forge-install.sh" "$@"
    ;;
  fractal)
    shift
    exec python3 "$ROOT/scripts/forge-fractal.py" "$@"
    ;;
  decide)
    shift
    exec python3 "$ROOT/scripts/forge-decide.py" "$@"
    ;;
  jev)
    shift
    # Only the launcher says so: forge's own callers run forge-jev.py directly.
    case "${1:-}" in
      setup) NEW='forge decide provider add …' ;;
      sites) NEW='forge decide gate <gate> <mode> --provider <name>' ;;
      enable) NEW='forge decide gate <gate> on' ;;
      disable) NEW='forge decide gate <gate> off' ;;
      status) NEW='forge decide status' ;;
      doctor) NEW='forge decide doctor' ;;
      *) NEW='' ;;
    esac
    [ -n "$NEW" ] && printf 'forge jev is replaced by forge decide (this alias stays for one release): %s\n' "$NEW" >&2
    exec python3 "$ROOT/scripts/forge-jev.py" "$@"
    ;;
  dataset)
    shift
    exec python3 "$ROOT/scripts/forge-dataset.py" "$@"
    ;;
  issues)
    shift
    exec python3 "$ROOT/scripts/forge-issues.py" "$@"
    ;;
  ui)
    shift
    exec python3 "$ROOT/scripts/forge-ui.py" "$@"
    ;;
  runs)
    shift
    exec python3 "$ROOT/scripts/forge-runs.py" "$@"
    ;;
  control)
    shift
    exec python3 "$ROOT/scripts/forge-control.py" "$@"
    ;;
  config)
    shift
    exec python3 "$ROOT/scripts/forge-config.py" "$@"
    ;;
  update)
    shift
    exec /bin/bash "$ROOT/scripts/forge-update.sh" "$@"
    ;;
  version)
    shift
    exec python3 "$ROOT/scripts/forge-version.py" "$@"
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  '')
    usage >&2
    exit 2
    ;;
  *)
    printf 'forge: unknown command: %s\n' "$1" >&2
    GUESS="$(suggest "$1")"
    [ -n "$GUESS" ] && printf 'Did you mean `forge %s`?\n' "$GUESS" >&2
    printf '\n' >&2
    usage >&2
    exit 2
    ;;
esac
