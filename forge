#!/usr/bin/env bash
set -uo pipefail
# npm runs this file through a symlink in its bin dir, usually a relative one. Follow the
# links so ROOT is the package and not the bin dir; older macOS has no readlink -f.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
ROOT="$(cd -P "$(dirname "$SELF")" && pwd)"

usage() {
  printf '%s\n' \
    'usage: forge <command> [args]' \
    '' \
    'commands:' \
    '  install   link forge into each agent harness on this machine; --dry-run previews' \
    '  fractal   opt-in Fractal execution: install, doctor, runs, status, tree, logs, open, report, ...' \
    '  jev       optional Jev advice: setup, status, doctor, enable, disable, backtest' \
    '  dataset   every run'"'"'s inputs and outcomes: status, dump, import, export, outcomes, ...' \
    '  issues    file the review findings a run left open as GitHub issues (plain gh)' \
    '  ui        forge-ui, the run viewer: open [DIR], status, stop' \
    '  runs      this repo'"'"'s recent runs in the terminal: state, verdicts and run dirs' \
    '  update    fast-forward this checkout and refresh every harness installation' \
    '  version   the installed version, and whether a newer release is out' \
    '' \
    'Run `forge <command> --help` for its options.' \
    'Runs start from your agent harness (/forge "<goal>" --dwarf <model>); see README.md.'
}

case "${1:-}" in
  install)
    shift
    exec /bin/bash "$ROOT/scripts/forge-install.sh" "$@"
    ;;
  fractal)
    shift
    exec python3 "$ROOT/scripts/forge-fractal.py" "$@"
    ;;
  jev)
    shift
    exec python3 "$ROOT/scripts/forge-jev.py" "$@"
    ;;
  dataset)
    shift
    exec python3 "$ROOT/scripts/forge-dataset.py" "$@"
    ;;
  issues)
    shift
    exec python3 "$ROOT/scripts/forge-issues.py" "$@"
    ;;
  ui)
    shift
    exec python3 "$ROOT/scripts/forge-ui.py" "$@"
    ;;
  runs)
    shift
    exec python3 "$ROOT/scripts/forge-runs.py" "$@"
    ;;
  update)
    shift
    exec /bin/bash "$ROOT/scripts/forge-update.sh" "$@"
    ;;
  version)
    shift
    exec python3 "$ROOT/scripts/forge-version.py" "$@"
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  '')
    usage >&2
    exit 2
    ;;
  *)
    printf 'forge: unknown command: %s\n\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac
