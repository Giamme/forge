.DS_Store
*.swp

# skill-creator eval workspaces, if they ever land beside the skill
*-workspace/
evals/results/

# Offline Python checks
__pycache__/
*.pyc
# tests/run_tests.py: how long each test class took last time, to start the slowest first
tests/.durations.json

# npm: `npm pack` leaves its tarball here. package-lock.json is committed: forge has no
# dependencies, but the lockfile records its version (changelogger refreshes it on release).
giamme-forge-*.tgz

# Impeccable's working files: review screenshots, decision-page logs and its edit hook's cache
# (PRODUCT.md, DESIGN.md, .impeccable/design.json and the surface briefs are the record)
.impeccable/review/
.impeccable/questions/
.impeccable/hook.cache.json

# September routing-research output. Untracked so a review export does not copy it
# into every run dir (#35).
jev-backtests/

# The website's build output (site/build.py); GitHub Pages builds it in CI
site/_site/

# Impeccable decision-round sketches (the chosen direction lives in the surface briefs)
.impeccable/mocks/
